# ---- Wonderla QR admin ----
# Single admin account used to sign in at /qr-code/admin
QR_ADMIN_USERNAME=admin
QR_ADMIN_PASSWORD=change-me-strong-password

# Secret used to sign the admin session cookie (use a long random string)
QR_ADMIN_SECRET=please-generate-a-long-random-secret

# Optional: override where park JSON files are stored.
# Defaults to <project>/data/qr-code
# QR_DATA_DIR=/var/data/wonderla-qr

# Google Maps JavaScript API key (set in .env.local and Vercel environment variables)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
